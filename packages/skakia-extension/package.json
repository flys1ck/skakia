{
  "name": "skakia-extension",
  "private": true,
  "version": "0.0.3",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:edge": "wxt build -b edge",
    "build:safari": "wxt build -b safari",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "zip:edge": "wxt zip -b edge",
    "submit:chrome": "wxt submit --chrome-api-version v2 --chrome-zip .output/skakia-extension-$npm_package_version-chrome.zip",
    "submit:firefox": "wxt submit --firefox-zip .output/skakia-extension-$npm_package_version-firefox.zip --firefox-sources-zip .output/skakia-extension-$npm_package_version-sources.zip --firefox-extension-id extension@skakia.com --firefox-channel listed --firefox-amo-metadata-file amo-metadata.json",
    "postinstall": "wxt prepare",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --fix",
    "lint:check": "oxlint",
    "types:check": "tsc --noEmit"
  },
  "devDependencies": {
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wxt": "^0.21.5"
  }
}
